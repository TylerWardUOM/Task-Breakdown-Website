DATABASE_URL=postgresql://username:password@localhost:5432/task_manager
DATABASE_PUBLIC_URL=
PORT=5000
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=

# 1) JSON string for hosted environments:
#    Preferred: FIREBASE_SERVICE_ACCOUNT contains the Firebase service account JSON payload.
FIREBASE_SERVICE_ACCOUNT=
#    Legacy/backward-compatible: FIREBASE_SERVICE_ACCOUNT_JSON may be used instead
#    and should contain the same Firebase service account JSON payload.
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2) Local fallback file (create this locally only):
# backend/serviceAccountKey.json
# This file contains credentials, must never be committed, and is already ignored by backend/.gitignore.
